{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcf.dev/schemas/pcf/0.2",
  "type": "object",
  "properties": {
    "pcf_version": {
      "const": "0.2"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$(?!\\n)"
          },
          "kind": {
            "enum": [
              "tools",
              "system",
              "memory",
              "document",
              "history",
              "user"
            ]
          },
          "content": {},
          "stable": {
            "type": "boolean"
          },
          "authority": {
            "enum": [
              "instruction",
              "data"
            ]
          },
          "provenance": {
            "type": "string",
            "minLength": 1,
            "$ref": "#/$defs/nonblank"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$(?!\\n)"
          }
        },
        "required": [
          "id",
          "kind",
          "content"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "tools"
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "$ref": "#/$defs/nonblank"
                      },
                      "description": {
                        "type": "string"
                      },
                      "parameters": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "name",
                      "parameters"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                },
                "authority": {
                  "const": "instruction"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "history"
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "object",
                        "properties": {
                          "role": {
                            "const": "user"
                          },
                          "content": {
                            "type": [
                              "string",
                              "object"
                            ],
                            "minLength": 1,
                            "minProperties": 1,
                            "not": {
                              "type": "object",
                              "required": [
                                "type"
                              ],
                              "properties": {
                                "type": {
                                  "const": "tool_use"
                                }
                              }
                            }
                          }
                        },
                        "required": [
                          "role",
                          "content"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "object",
                        "properties": {
                          "role": {
                            "const": "assistant"
                          },
                          "content": {
                            "type": [
                              "string",
                              "object"
                            ],
                            "not": {
                              "type": "object",
                              "required": [
                                "type"
                              ],
                              "properties": {
                                "type": {
                                  "const": "tool_use"
                                }
                              }
                            }
                          },
                          "tool_calls": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "$ref": "#/$defs/nonblank"
                                },
                                "name": {
                                  "type": "string",
                                  "minLength": 1,
                                  "$ref": "#/$defs/nonblank"
                                },
                                "arguments": {
                                  "type": "object"
                                }
                              },
                              "required": [
                                "id",
                                "name",
                                "arguments"
                              ],
                              "additionalProperties": false
                            },
                            "minItems": 1
                          },
                          "provider_blocks": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "object",
                              "properties": {
                                "provider": {
                                  "enum": [
                                    "anthropic",
                                    "openai"
                                  ]
                                },
                                "block": {
                                  "type": "object",
                                  "required": [
                                    "type"
                                  ],
                                  "properties": {
                                    "type": {
                                      "type": "string"
                                    }
                                  }
                                }
                              },
                              "required": [
                                "provider",
                                "block"
                              ],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "role",
                          "content"
                        ],
                        "additionalProperties": false,
                        "anyOf": [
                          {
                            "required": [
                              "tool_calls"
                            ]
                          },
                          {
                            "properties": {
                              "content": {
                                "minLength": 1,
                                "minProperties": 1
                              }
                            }
                          }
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "role": {
                            "const": "tool"
                          },
                          "call_id": {
                            "type": "string",
                            "minLength": 1,
                            "$ref": "#/$defs/nonblank"
                          },
                          "content": {},
                          "is_error": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "role",
                          "call_id",
                          "content",
                          "is_error"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  },
                  "minItems": 0
                },
                "authority": {
                  "const": "data"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "system",
                    "memory",
                    "document",
                    "user"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "content": {
                  "type": [
                    "string",
                    "object"
                  ],
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "system"
                }
              }
            },
            "then": {
              "properties": {
                "authority": {
                  "const": "instruction"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "user"
                }
              }
            },
            "then": {
              "properties": {
                "authority": {
                  "const": "data"
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "$ref": "#/$defs/nonblank"
    },
    "cache_namespace": {
      "type": "string",
      "minLength": 1,
      "$ref": "#/$defs/nonblank"
    }
  },
  "required": [
    "pcf_version",
    "segments"
  ],
  "additionalProperties": false,
  "description": "Immutable PCF 0.2 context. Runtime also checks ordering, unique identifiers, call/result linkage, canonical JSON and declared hashes. Namespace must identify the intended trusted sharing group.",
  "$defs": {
    "nonblank": {
      "$comment": "At least one character that Python's str.strip() keeps (the runtime nonempty() check). Spelled out because \\S differs between Python re and ECMA-262.",
      "pattern": "[^\\t\\n\\x0b\\x0c\\r\\x1c-\\x20\\x85\\xa0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]"
    }
  }
}
